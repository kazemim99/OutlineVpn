<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>OutlineApi</Title>
        <Authors>sfsef</Authors>
        <Description>Library for Outline VPN API</Description>
        <PackageProjectUrl>https://github.com/sfsef/OutlineVpn</PackageProjectUrl>
        <RepositoryUrl>https://github.com/sfsef/OutlineVpn</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    </ItemGroup>

</Project>
